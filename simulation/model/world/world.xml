<mujoco>

    <!-- Large, flat laboratory floor -->
    <geom name="ground" type="plane" size="40 40 0.1" material="floor_material"
        friction="0.9 0.005 0.0001" />

    <!-- Main directional light -->
    <light name="main_light" pos="0 -3 6" dir="0.2 0.3 -1" directional="true"
        diffuse="0.85 0.85 0.85" specular="0.25 0.25 0.25" />

    <!-- Soft fill light -->
    <light name="fill_light" pos="4 2 4" dir="-1 -0.5 -1" directional="true"
        diffuse="0.35 0.35 0.35" specular="0.1 0.1 0.1" />

</mujoco>